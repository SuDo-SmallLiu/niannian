# 复制为 .env.local 后填入真实值（切勿提交 .env.local）
# cp .env.example .env.local

# ── AI 网关 ──
# 主网关推荐：联通云（OpenAI 兼容）
#   ARK_BASE_URL=https://aigw-gzgy2.cucloud.cn:8443/v1
#   ARK_TEXT_MODEL=DeepSeek-V4-Flash
#   ARK_VISION_MODEL=kimi-k2.5
# 备用网关：火山引擎 Ark
#   ARK_BASE_URL_FALLBACK=https://ark.cn-beijing.volces.com/api/v3
# 不填 ARK_API_KEY 则进入演示模式
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://aigw-gzgy2.cucloud.cn:8443/v1
ARK_TEXT_MODEL=DeepSeek-V4-Flash
ARK_VISION_MODEL=kimi-k2.5
ARK_API_KEY_FALLBACK=
ARK_BASE_URL_FALLBACK=https://ark.cn-beijing.volces.com/api/v3
# 可选：单独配置视觉 Key（默认与主 Key 相同网关）
# 图片解析示例：阿里云 MaaS
#   ARK_VISION_BASE_URL=https://xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   ARK_VISION_MODEL=qwen-vl-max
ARK_VISION_API_KEY=
ARK_VISION_BASE_URL=
ARK_VISION_MODEL_FALLBACKS=qwen-vl-plus,qwen3-vl-plus
ARK_VISION_MODEL_FALLBACK=
ARK_VISION_MODEL_FALLBACKS=
ARK_TEXT_MODEL=
ARK_TEXT_MODEL_FALLBACKS=
ARK_STT_MODEL=doubao-seed-asr-1-0

# ── 认证 ──
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_SMS=false
AUTH_COOKIE_SECURE=
# 生产演示专用：允许快速登录 / 本地验证码模式（正式环境勿开）
ALLOW_DEV_AUTH=

# ── 应用 ──
DATABASE_PATH=./data/niannian.db
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# ── 旁白 MeloTTS ──
MELO_PYTHON=./services/narration/.venv/bin/python3
HF_ENDPOINT=https://hf-mirror.com
NUMBA_CACHE_DIR=./.cache/numba
