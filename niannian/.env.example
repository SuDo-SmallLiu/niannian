# 复制为 .env.local 后填入真实值（切勿提交 .env.local）
# cp .env.example .env.local

# ── AI（火山引擎 Ark，不填则演示模式）──
ARK_API_KEY=your_ark_api_key_here
ARK_API_KEY_FALLBACK=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL_FALLBACK=
ARK_VISION_API_KEY=
ARK_VISION_BASE_URL=
ARK_VISION_MODEL=
ARK_VISION_MODEL_FALLBACK=
ARK_VISION_MODEL_FALLBACKS=
ARK_TEXT_MODEL=
ARK_TEXT_MODEL_FALLBACKS=
ARK_STT_MODEL=doubao-seed-asr-1-0

# ── 认证 ──
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_SMS=false
AUTH_COOKIE_SECURE=

# ── 应用 ──
DATABASE_PATH=./data/niannian.db
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# ── 旁白 MeloTTS ──
MELO_PYTHON=./services/narration/.venv/bin/python3
HF_ENDPOINT=https://hf-mirror.com
NUMBA_CACHE_DIR=./.cache/numba
